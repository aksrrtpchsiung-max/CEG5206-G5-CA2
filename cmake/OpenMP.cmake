if(TARGET OpenMP::OpenMP_CXX)
  return()
endif()
# Apple Clang needs the include/library paths for Homebrew's keg-only libomp.
if(APPLE AND NOT DEFINED OpenMP_ROOT)
  if(DEFINED ENV{OMP_PREFIX})
    set(OpenMP_ROOT "$ENV{OMP_PREFIX}")
  else()
    set(OpenMP_ROOT "/opt/homebrew/opt/libomp")
  endif()
  if(EXISTS "${OpenMP_ROOT}/lib/libomp.dylib")
    set(OpenMP_CXX_FLAGS "-Xpreprocessor -fopenmp")
    set(OpenMP_CXX_INCLUDE_DIR "${OpenMP_ROOT}/include")
    set(OpenMP_CXX_LIB_NAMES omp)
    set(OpenMP_omp_LIBRARY "${OpenMP_ROOT}/lib/libomp.dylib")
  endif()
endif()
find_package(OpenMP REQUIRED COMPONENTS CXX)
set_property(TARGET OpenMP::OpenMP_CXX PROPERTY IMPORTED_GLOBAL TRUE)
